<!doctype html>
<html lang="ko">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %></title>
</head>
<body>
  <header>
    <h1>사내 장비 대여 관리</h1>
  </header>
  <main>
    <%# 장비 목록 영역. 행마다 한 장비. 상태는 서버가 붙인 statusLabel 을 배지로 표시한다. %>
    <section id="equipment-list" aria-labelledby="equipment-list-title">
      <h2 id="equipment-list-title">장비 목록</h2>
      <table>
        <thead>
          <tr>
            <th scope="col">장비명</th>
            <th scope="col">종류</th>
            <th scope="col">상태</th>
            <th scope="col">작업</th>
          </tr>
        </thead>
        <tbody>
          <% equipment.forEach(function (item) { %>
          <tr class="equipment-row" data-equipment-id="<%= item.id %>">
            <td class="equipment-name"><%= item.name %></td>
            <td class="equipment-type"><%= item.type %></td>
            <td class="equipment-status"><span class="badge badge--<%= item.status %>"><%= item.statusLabel %></span></td>
            <td class="equipment-actions">
              <% if (item.status === 'available') { %>
              <%# 대여 폼은 행 안 인라인 펼침(<details>)으로 통일한다. JS 없이도 열리고 제출된다. %>
              <details class="rent-toggle">
                <summary class="btn btn--primary">대여</summary>
                <form class="rent-form" method="post" action="/equipment/<%= item.id %>/rent">
                  <button type="submit" class="btn btn--primary">대여</button>
                </form>
              </details>
              <% } %>
            </td>
          </tr>
          <% }); %>
        </tbody>
      </table>
    </section>
  </main>
</body>
</html>

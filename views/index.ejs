<!doctype html>
<html lang="ko">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %></title>
</head>
<body>
  <header>
    <h1>사내 장비 대여 관리</h1>
  </header>
  <main>
    <%# 장비 목록 영역. 행마다 한 장비. 상태 칼럼은 F-006 에서 td 를 추가해 확장한다. %>
    <section id="equipment-list" aria-labelledby="equipment-list-title">
      <h2 id="equipment-list-title">장비 목록</h2>
      <table>
        <thead>
          <tr>
            <th scope="col">장비명</th>
            <th scope="col">종류</th>
          </tr>
        </thead>
        <tbody>
          <% equipment.forEach(function (item) { %>
          <tr class="equipment-row" data-equipment-id="<%= item.id %>">
            <td class="equipment-name"><%= item.name %></td>
            <td class="equipment-type"><%= item.type %></td>
          </tr>
          <% }); %>
        </tbody>
      </table>
    </section>
  </main>
</body>
</html>
